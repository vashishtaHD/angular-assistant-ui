{
  "name": "angular-assistant-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "dev": "npm run build:lib && concurrently -k -n mastra,demo -c magenta,cyan \"npm run dev -w mastra-server\" \"ng serve demo\"",
    "lint": "ng lint",
    "test": "npm run test:lib && npm run test:demo && npm run test -w mastra-server --if-present",
    "test:lib": "vitest run --root projects/assistant-ui-angular",
    "test:lib:watch": "vitest --root projects/assistant-ui-angular",
    "test:demo": "vitest run --root projects/demo",
    "test:demo:watch": "vitest --root projects/demo",
    "build:lib": "ng build assistant-ui-angular",
    "check:ui-styles": "node scripts/check-ui-styles-asset.mjs",
    "check:react-compat": "node scripts/check-react-compat.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "test:scripts": "node --test scripts/check-parity.test.mjs scripts/check-react-compat.test.mjs scripts/check-package.test.mjs scripts/release-notes.test.mjs scripts/check-readme-samples.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:readme-samples": "node scripts/check-readme-samples.mjs",
    "build:demo": "ng build demo",
    "typecheck:mastra": "npm run typecheck -w mastra-server --if-present",
    "compat": "node scripts/compat.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:lib-spec": "tsc -p projects/assistant-ui-angular/tsconfig.spec.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@assistant-ui/ai-sdk": "0.0.18",
    "ai": "^7.0.173",
    "react": "^19.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.20.1",
    "@analogjs/vitest-angular": "^1.20.1",
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cdk": "~18.2.14",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@assistant-ui/core": "~0.3.37",
    "@assistant-ui/store": "~0.3.23",
    "@assistant-ui/tap": "~0.9.26",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "angular-eslint": "^18.4.3",
    "autoprefixer": "^10.6.2",
    "commonmark-spec": "^0.31.2",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^26.1.0",
    "markdown-it": "^15.0.3",
    "ng-packagr": "^18.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "~3.2.4"
  },
  "workspaces": [
    "projects/*",
    "mastra-server"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
