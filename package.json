{
  "name": "angular-assistant-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "lint": "ng lint",
    "test": "npm run test:lib && npm run test -w mastra-server --if-present",
    "test:lib": "vitest run --root projects/assistant-ui-angular",
    "test:lib:watch": "vitest --root projects/assistant-ui-angular",
    "build:lib": "ng build assistant-ui-angular",
    "build:demo": "ng build demo",
    "typecheck:mastra": "npm run typecheck -w mastra-server --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.20.1",
    "@analogjs/vitest-angular": "^1.20.1",
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@assistant-ui/core": "~0.3.36",
    "@assistant-ui/store": "~0.3.23",
    "@assistant-ui/tap": "~0.9.26",
    "@types/react": "^19.3.0",
    "angular-eslint": "^18.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "jsdom": "^26.1.0",
    "ng-packagr": "^18.2.0",
    "prettier": "^3.10.1",
    "typescript": "~5.5.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "~3.2.4"
  },
  "workspaces": [
    "projects/*",
    "mastra-server"
  ],
  "engines": {
    "node": ">=20.11 <23"
  }
}
