# Provider keys. Set the one matching MASTRA_MODEL.
OPENAI_API_KEY=
# Used when MASTRA_MODEL is an OpenRouter model, e.g. openrouter/<vendor>/<model>
OPENROUTER_API_KEY=
# Model router string "provider/model". Defaults to openai/gpt-6-luna when empty.
MASTRA_MODEL=
# Origin allowed by CORS (the Angular dev server)
FRONTEND_ORIGIN=http://localhost:4200
