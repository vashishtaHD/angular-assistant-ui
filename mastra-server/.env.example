# Provider keys. Set the one matching MASTRA_MODEL.
OPENAI_API_KEY=
# Used when MASTRA_MODEL is an OpenRouter model, e.g. openrouter/<vendor>/<model>
OPENROUTER_API_KEY=
# Model router string "provider/model". Defaults to openai/gpt-6-luna when empty.
MASTRA_MODEL=
# Origin allowed by CORS (the Angular dev server)
FRONTEND_ORIGIN=http://localhost:4200

# Authentication (required, the server refuses to start without a mode)
# dev: every request is the fixed user "dev-user". Needs MASTRA_DEV_AUTH=1. Local development only.
# jwt: requests must carry "Authorization: Bearer <token>"; the token's `sub` is the user id.
MASTRA_AUTH_MODE=dev
MASTRA_DEV_AUTH=1
# jwt mode: shared secret for HS256 tokens (the example verifier). Use a long random value.
MASTRA_JWT_SECRET=

# Storage for threads and messages (LibSQL). Defaults to file:./mastra.db
MASTRA_DB_URL=file:./mastra.db
# Largest accepted chat request body in bytes (default 10485760 = 10 MiB)
MASTRA_MAX_BODY_BYTES=
